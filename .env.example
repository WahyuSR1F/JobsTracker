# Database (Turso / libSQL)
# Setelah diisi, jalankan: npm run db:migrate
#   dev lokal  : file:./local.db
#   Turso      : libsql://<nama-db>-<org>.turso.io + auth token dari `turso db tokens create`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session signing secret, minimal 32 karakter
# contoh: openssl rand -hex 32
AUTH_SECRET=

# URL aplikasi (dipakai untuk redirect URI OAuth)
# dev:  http://localhost:3000
# prod: https://domainkamu.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth
# Redirect URI yang harus didaftarkan:
#   {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth (produk "Sign In with LinkedIn using OpenID Connect")
# Redirect URI yang harus didaftarkan:
#   {NEXT_PUBLIC_APP_URL}/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ===== Agregator lowongan kerja (Pengaturan → Metode 1 & 2) =====
# Metode 1: API & RSS.
# JSearch di RapidAPI dipakai untuk sumber LinkedIn. Daftar di rapidapi.com,
# subscribe "JSearch", lalu salin key-nya ke sini.
RAPIDAPI_KEY=
# Hanya perlu bila kamu punya akses partner API JobStreet.
JOBSTREET_API_KEY=
# Metode 2: web scraping. Opsional, ganti User-Agent bila situs target memblokir.
JOB_SCRAPER_USER_AGENT=
# Lama cache hasil agregator dalam milidetik (default 900000 = 15 menit).
JOB_AGGREGATOR_CACHE_TTL_MS=900000
